# Supabase remains the identity provider for Discord login and account admin.
SUPABASE_URL=https://hpbqoochibnrxzxeuazb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CQPZKB4Houc0UPn-sccxOQ_uZTD-X37

# Railway Postgres is the source of truth for all website and bot data.
# Vercel must use Railway's public Postgres URL; *.railway.internal only resolves inside Railway.
# NEVER commit the real URL. Store it as a Sensitive environment variable in Vercel.
DATABASE_URL=postgresql://user:password@public-railway-host:port/railway

# Required only for account email/password administration in api/account.js.
# This key is no longer used for website data access.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_auth_service_role_key_here

# Used by api/discord-refresh.js so signed-in users can silently renew their
# Discord access token instead of being sent through Discord's consent screen
# on every visit. Must be the SAME Discord application configured under
# Supabase Dashboard -> Authentication -> Providers -> Discord (client ID
# below is Bound's bot application and is very likely correct, but confirm
# it against that Supabase provider setting). The client secret is on the
# Discord Developer Portal -> your application -> OAuth2 -> Client secret -
# never commit the real value, only set it in Vercel.
DISCORD_CLIENT_ID=1537633630384300113
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
