# Railway Postgres is the source of truth for all website and bot data.
# Vercel must use Railway's public Postgres URL; *.railway.internal only resolves inside Railway.
# NEVER commit the real URL. Store it as a Sensitive environment variable in Vercel.
DATABASE_URL=postgresql://user:password@public-railway-host:port/railway

# Signs and verifies the site's own Bound session cookie (server/auth.js) -
# there is no external identity provider any more, Discord OAuth is handled
# directly by api/discord-oauth.js. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store it as a Sensitive value in Vercel. Rotating it signs every active
# session out at once.
SESSION_SECRET=your_generated_session_secret_here

# Back the entire Discord OAuth flow (login, callback and silent refresh) in
# api/discord-oauth.js. Client ID below is Bound's bot application. The
# client secret is on the Discord Developer Portal -> your application ->
# OAuth2 -> Client secret - never commit the real value, only set it in
# Vercel. The Developer Portal's OAuth2 redirect list must include
# https://<your-domain>/api/discord-oauth?action=callback.
DISCORD_CLIENT_ID=1537633630384300113
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
